---
deadlock_detection: true
options:
  max_actions: 40
  max_concurrent_actions: 1
  crash_on_yield: false
---

# chisel cut pipeline: setup.validate -> setup.Select -> Selection.Prefers -> slicer.Run (extract,
# generate, mutate, removeAfterMutate, report).
#
# run:   fizz chisel-cut.fizz
#        fizzbee 0.5.4 (https://github.com/fizzbee-io/fizzbee), from its brew tap or a release
#        tarball. ~55k states, about a minute; prints PASSED or a counterexample trace. the run
#        leaves an out/ dir and a chisel-cut.fizz.json next to this file.
#
# this is a transcription of the rule set in internal/slicer/slicer.go and internal/setup/setup.go
# (chisel abb0ccc), not of the code: globs, hard links, symlinks, modes, archives, stores and the
# manifest file itself are out. the environment is the release (two packages, one slice each, three
# paths), the host arch, the selection, and the orders go leaves open (selection order among
# unrelated slices, go map iteration over generated paths).
#
# requirements (intent, not mechanism):
# R1:  THE SYSTEM SHALL reject a release in which two packages list the same path with different
#      content or both extract it, unless a prefer relationship picks one of them.
# R2:  WHEN a selected slice lists a file for the host arch with no `until`, THE SYSTEM SHALL leave
#      that file in the rootfs after the cut.
# R3:  WHEN every selected slice that lists a path marks it `until: mutate`, THE SYSTEM SHALL remove
#      the path after mutation scripts ran, a directory only once it is empty.
# R4:  WHEN two selected packages list the same path and one is preferred, THE SYSTEM SHALL take the
#      path from the preferred package.
# R5:  THE SYSTEM SHALL list in the manifest every path left in the rootfs that a selected slice
#      lists, attributed to each selected slice that lists it for the host arch and is not a prefer
#      loser.
# R6:  WHILE a release passed validation and every script only touches paths its slice may touch,
#      THE SYSTEM SHALL complete the cut without error.
# R7:  THE SYSTEM SHALL produce the same rootfs and manifest for the same release, arch and
#      selection whatever internal order it processes in.
# R8:  IF a directory is only ever created as the parent of some listed path, THEN THE SYSTEM SHALL
#      keep it.
#
# findings (each confirmed with a go test against slicer.Run, then fixed in the go code and in this
# model; the fixes are marked `FIX Fn` below, undo one and the checker produces the trace):
# F1: `mutable: true` + `until: mutate` on a path a script writes fails the cut in report.Mutate
#     ("not previously added"); validate accepts it. fix: validate rejects the combination (no
#     release branch uses it).
# F2: Selection.Prefers ignores arch. when the preferred package lists the path for another arch
#     only, nobody extracts it and the path is silently missing. fix: Selection carries Arch,
#     Prefers skips other-arch listings.
# F3: addKnownPath is first-write-wins, so a directory registered implicitly as a parent swallows a
#     later explicit `until: mutate` listing. hit deterministically (extract before generate) and
#     randomly (go map order over generated paths). fix: explicit listings override implicit ones.
# F4 (decision, not fixed): generated content is attributed to every lister once the merged until is
#     none, incl. the slice that said until: mutate; an upstream test pins this. the extraction
#     branch attributes per slice instead (go test H5), so the two branches disagree. R5 follows the
#     tested rule; which branch is wrong is for chisel maintainers.
#
# decisions:
# - a prefer loser is not attributed in the manifest (R5): the content is the preferred package's,
#   so attributing the loser would mislead.
# - scripts are fixed: a slice writes TEXT iff it lists TEXT as mutable, and reads FILE iff it lists
#   FILE for the host arch. the reads/writes a script may do are an environment freedom; narrowed to
#   keep the state space small. consequence: a write to a non-mutable path (a script author error,
#   rejected by checkMutable) is never exercised, the m_write_non_mutable mutant passes.

DIR = "/d/"
FILE = "/d/f"
TEXT = "/d/t"

NONE = "none"
MUTATE = "mutate"
UNTILS = [NONE, MUTATE]

SLICES = ["Ps", "Qs"]
PKG = {"Ps": "P", "Qs": "Q"}

# per-slice per-path listing options. kind: copy (extracted from the deb), make (directory created
# by chisel), text (file created by chisel).
DIR_OPTS = [struct(kind="copy", until=NONE, mutable=False, arch="any", prefer=""),
            struct(kind="copy", until=MUTATE, mutable=False, arch="any", prefer=""),
            struct(kind="make", until=MUTATE, mutable=False, arch="any", prefer="")]
FILE_OPTS_P = [struct(kind="copy", until=NONE, mutable=False, arch="any", prefer=""),
               struct(kind="copy", until=MUTATE, mutable=False, arch="any", prefer=""),
               struct(kind="copy", until=NONE, mutable=False, arch="A", prefer="")]
FILE_OPTS_Q = [struct(kind="copy", until=u, mutable=False, arch="any", prefer=p)
               for u in UNTILS for p in ["", "P"]]
TEXT_OPTS = [struct(kind="text", until=NONE, mutable=False, arch="any", prefer=""),
             struct(kind="text", until=NONE, mutable=True, arch="any", prefer=""),
             struct(kind="text", until=MUTATE, mutable=True, arch="any", prefer="")]

SELECTIONS = [["Ps"], ["Qs"], ["Ps", "Qs"], ["Qs", "Ps"]]


atomic func pick(opts):
    # index 0 means "not listed"
    i = oneof range(len(opts) + 1)
    if i == 0:
        return None
    return opts[i - 1]


# ---- setup.validate (R1) -----------------------------------------------------

atomic func validate(rel):
    for p in [DIR, FILE, TEXT]:
        a = rel["Ps"].get(p, None)
        b = rel["Qs"].get(p, None)
        if a == None or b == None:
            continue
        if b.prefer == "P":
            # preferredPathPackage finds a relation, skip content check
            continue
        same = (a.kind == b.kind and a.mutable == b.mutable)
        if not same or a.kind == "copy":
            return "conflict on " + p
    # prefer target must contain the path
    for p in [DIR, FILE, TEXT]:
        b = rel["Qs"].get(p, None)
        if b != None and b.prefer == "P" and rel["Ps"].get(p, None) == None:
            return "prefer target lacks " + p
    # FIX F1: a path removed after mutate cannot be mutable
    for s in SLICES:
        for p in [DIR, FILE, TEXT]:
            l = rel[s].get(p, None)
            if l != None and l.mutable and l.until == MUTATE:
                return "mutable with until mutate on " + p
    return ""


# ---- Selection.Prefers (selected slices only, arch ignored) -----------------

atomic func prefers(rel, sel):
    out = {}
    for p in [DIR, FILE, TEXT]:
        has_rel = False
        for s in SLICES:
            l = rel[s].get(p, None)
            if l != None and l.prefer != "":
                has_rel = True
        if not has_rel:
            continue
        chosen = ""
        for s in sel:
            l = rel[s].get(p, None)
            if l == None:
                continue
            # FIX F2: a listing for another arch does not take part
            if not (l.arch == "any" or l.arch == arch):
                continue
            if chosen == "":
                chosen = PKG[s]
            elif chosen != PKG[s]:
                chosen = "P"   # the only relation in the model: Q prefers P
        if chosen != "":
            out[p] = chosen
    return out


# ---- slicer.Run bookkeeping --------------------------------------------------

atomic func add_known(path, data):
    # addKnownPath: first write wins, parents get empty data
    # FIX F3/H2: an explicit listing overrides an implicit parent entry
    if path in known and not known[path].implicit:
        return
    known[path] = struct(until=data.until, mutable=data.mutable, implicit=False)
    if not path.endswith("/"):
        par = DIR
        if par not in known:
            known[par] = struct(until=NONE, mutable=False, implicit=True)


atomic func create(path, content, ctxs):
    # ctxs: list of slices whose contents list `path`; [] for implicit parents
    fs[path] = content
    if len(ctxs) == 0:
        return
    until = MUTATE
    mutable = False
    for s in ctxs:
        info = release[s][path]
        mutable = mutable or info.mutable
        if info.until == NONE:
            until = NONE
        if info.until != MUTATE:
            report_add(s, path, content)
    add_known(path, struct(until=until, mutable=mutable))


atomic func report_add(s, path, content):
    if path not in report:
        report[path] = {}
    report[path][s] = content


atomic func report_mutate(path, content):
    if path not in report:
        return "cannot mutate path in report: " + path + " not previously added"
    for s in report[path]:
        report[path][s] = content
    return ""


action Init:
    phase = "NEW"
    release = {"Ps": {}, "Qs": {}}
    d = pick(DIR_OPTS)
    if d != None:
        release["Ps"][DIR] = d
    f = pick(FILE_OPTS_P)
    if f != None:
        release["Ps"][FILE] = f
    t = pick(TEXT_OPTS)
    if t != None:
        release["Ps"][TEXT] = t
    d = pick(DIR_OPTS)
    if d != None:
        release["Qs"][DIR] = d
    f = pick(FILE_OPTS_Q)
    if f != None:
        release["Qs"][FILE] = f
    t = pick(TEXT_OPTS)
    if t != None:
        release["Qs"][TEXT] = t
    arch = "A"
    if FILE in release["Ps"] and release["Ps"][FILE].arch == "A":
        arch = oneof ["A", "B"]
    selection = []
    prefer_map = {}
    fs = {}
    known = {}
    report = {}
    pending = []
    cut_error = ""
    expected_fs = {}
    expected_report = {}
    gen_order_seen = False
    gen_groups = {}


atomic action Validate:
    require phase == "NEW"
    err = validate(release)
    if err != "":
        phase = "INVALID"
    else:
        phase = "VALID"


atomic action Select:
    require phase == "VALID"
    selection = oneof SELECTIONS
    pm = prefers(release, selection)
    prefer_map = pm
    pending = list(selection)
    phase = "EXTRACT"


# tarball.Extract, one package per step in selection order. the deb carries DIR then FILE (dirs
# precede their files in a deb data tarball).
atomic action ExtractNext:
    require phase == "EXTRACT"
    if len(pending) == 0:
        pending = list(selection)
        phase = "GENERATE_PLAN"
        return
    s = pending[0]
    pending = pending[1:]
    pkg = PKG[s]
    targets = {}
    for p in release[s]:
        info = release[s][p]
        if not (info.arch == "any" or info.arch == arch):
            continue
        if p in prefer_map and prefer_map[p] != pkg:
            continue
        if info.kind == "copy":
            targets[p] = True
        elif not p.endswith("/"):
            # parent dir of generated content, optional, no context
            targets[DIR] = targets.get(DIR, False)
    # tar entry DIR
    if DIR in targets:
        if targets[DIR]:
            create(DIR, "dir", [s])
        else:
            create(DIR, "dir", [])
    # tar entry FILE
    if FILE in targets:
        # parent from tarDirMode, no context
        create(DIR, "dir", [])
        create(FILE, pkg, [s])


# generated content: group by path, then go iterates the map in random order
atomic action GeneratePlan:
    require phase == "GENERATE_PLAN"
    groups = {}
    for s in selection:
        for p in release[s]:
            info = release[s][p]
            if not (info.arch == "any" or info.arch == arch):
                continue
            if info.kind == "copy":
                continue
            if p in prefer_map and prefer_map[p] != PKG[s]:
                continue
            if p not in groups:
                groups[p] = []
            groups[p] = groups[p] + [s]
    gen_groups = groups
    pending = list(groups.keys())
    phase = "GENERATE"


atomic action GenerateNext:
    require phase == "GENERATE"
    if len(pending) == 0:
        pending = list(selection)
        phase = "MUTATE"
        return
    p = oneof pending
    if len(pending) > 1:
        gen_order_seen = True
    pending = [x for x in pending if x != p]
    listers = gen_groups[p]
    until = MUTATE
    for s in listers:
        if release[s][p].until == NONE:
            until = NONE
    first = release[listers[0]][p]
    add_known(p, struct(until=until, mutable=first.mutable))
    content = "dir"
    if not p.endswith("/"):
        content = "text"
        if DIR not in fs:
            fs[DIR] = "dir"   # MakeParents
    fs[p] = content
    if until != MUTATE:
        for s in listers:
            report_add(s, p, content)


atomic action MutateNext:
    require phase == "MUTATE"
    if len(pending) == 0:
        phase = "REMOVE"
        return
    s = pending[0]
    pending = pending[1:]
    if cut_error != "":
        return
    reads_file = FILE in release[s] and (release[s][FILE].arch == "any" or release[s][FILE].arch == arch)
    if reads_file:
        # content.read(FILE): checkKnown
        if FILE not in known:
            cut_error = "slice " + s + ": cannot read file which is not selected: " + FILE
            return
    if TEXT in release[s] and release[s][TEXT].mutable:
        # content.write(TEXT, ...): checkMutable then report.Mutate
        if TEXT not in known or not known[TEXT].mutable:
            cut_error = "slice " + s + ": cannot write file which is not mutable: " + TEXT
            return
        fs[TEXT] = "w:" + s
        err = report_mutate(TEXT, "w:" + s)
        if err != "":
            cut_error = "slice " + s + ": " + err


atomic action RemoveAfterMutate:
    require phase == "REMOVE"
    if cut_error == "":
        for p in [FILE, TEXT]:
            if p in known and known[p].until == MUTATE and p in fs:
                fs.pop(p)
        if DIR in known and known[DIR].until == MUTATE and DIR in fs:
            if FILE not in fs and TEXT not in fs:
                fs.pop(DIR)
    e = compute_expected()
    expected_fs = e.fs
    expected_report = e.report
    phase = "DONE"


atomic func compute_expected():
    efs = {}
    erep = {}
    # who provides each path after prefer + arch (R2, R4)
    for p in [FILE, TEXT]:
        provider = ""
        has_none = False
        attrib = {}
        for s in selection:
            info = release[s].get(p, None)
            if info == None or not (info.arch == "any" or info.arch == arch):
                continue
            if p in prefer_map and prefer_map[p] != PKG[s]:
                continue
            provider = PKG[s]
            if info.kind == "text":
                provider = "text"
            attrib[s] = True
            if info.until == NONE:
                has_none = True
        if provider != "" and has_none:
            efs[p] = provider
            erep[p] = attrib
    # scripts (fixed, see decisions): the last writer in selection order wins
    for s in selection:
        info = release[s].get(TEXT, None)
        if info != None and info.mutable and TEXT in efs:
            efs[TEXT] = "w:" + s
            for t in erep[TEXT]:
                erep[TEXT][t] = True
    # directory (R3, R8)
    listed = False
    listed_none = False
    child_created = False
    attrib = {}
    for s in selection:
        info = release[s].get(DIR, None)
        if info != None and (info.arch == "any" or info.arch == arch):
            listed = True
            if info.until == NONE:
                listed_none = True
                attrib[s] = True
        for p in [FILE, TEXT]:
            i = release[s].get(p, None)
            if i == None or not (i.arch == "any" or i.arch == arch):
                continue
            if p in prefer_map and prefer_map[p] != PKG[s]:
                continue
            child_created = True
    child_present = FILE in efs or TEXT in efs
    if listed_none or child_present or (child_created and not listed):
        efs[DIR] = "dir"
    if listed_none:
        erep[DIR] = attrib
    return struct(fs=efs, report=erep)


atomic action NoOp:
    require phase == "DONE" or phase == "INVALID"
    pass


# ---- properties --------------------------------------------------------------

always assertion RootfsMatchesIntent:     # R2 R3 R4 R7 R8
    if phase != "DONE" or cut_error != "":
        return True
    for p in expected_fs:
        if p not in fs or fs[p] != expected_fs[p]:
            return False
    for p in fs:
        if p not in expected_fs:
            return False
    return True


always assertion ManifestMatchesIntent:   # R5 R7
    if phase != "DONE" or cut_error != "":
        return True
    for p in expected_report:
        if p not in report:
            return False
        for s in expected_report[p]:
            if s not in report[p]:
                return False
        for s in report[p]:
            if s not in expected_report[p]:
                return False
    for p in report:
        if p not in expected_report:
            return False
    return True


always assertion ValidReleaseCuts:        # R6
    return cut_error == ""


exists assertion PreferApplied:
    return phase == "DONE" and FILE in prefer_map and len(selection) == 2 and FILE in fs


exists assertion DirRemoved:
    return phase == "DONE" and DIR in known and DIR not in fs


exists assertion FileRemoved:
    return phase == "DONE" and FILE in known and FILE not in fs


exists assertion TextWritten:
    return phase == "DONE" and TEXT in fs and fs[TEXT].startswith("w:")


exists assertion GenOrderBranched:
    return phase == "DONE" and gen_order_seen
